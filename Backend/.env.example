PORT=3000

# PostgreSQL (nueva base de datos principal)
# Local:  postgresql://postgres:postgres@localhost:5432/dnd_db?schema=public
# Neon / Supabase: copia la cadena de conexión que te da el panel
DATABASE_URL=postgresql://<usuario>:<password>@<host>:5432/dnd_db?schema=public

# MongoDB (solo mientras dure la migración de datos; se eliminará después)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/dnd_db

# Al menos 32 caracteres aleatorios. Genérala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria_de_32+_caracteres

# Orígenes que pueden llamar a la API (separados por comas)
FRONTEND_URL=http://localhost:4200
